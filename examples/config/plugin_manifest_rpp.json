{
  "plugin_id": "customer_rpp",
  "name": "Customer Regulated Pure Pursuit",
  "version": "1.0.0",
  "plugin_type": "LOCAL_CONTROLLER",
  "entrypoint": "custom_rpp_controller:CustomerRPPController",
  "author": "Partner AGV Team",
  "description": "具前視點、航向比例控制、加速度限幅與障礙減速的局部控制器範例",
  "capabilities": [
    "DIFFERENTIAL_DRIVE",
    "DYNAMIC_OBSTACLE_AVOIDANCE"
  ],
  "parameters": [
    {
      "name": "lookahead_dist",
      "type": "float",
      "default": 0.6,
      "description": "前視距離 (m)",
      "min_value": 0.1,
      "max_value": 3.0
    },
    {
      "name": "max_linear_vel",
      "type": "float",
      "default": 0.8,
      "description": "最大線速度 (m/s)",
      "min_value": 0.05,
      "max_value": 2.0
    },
    {
      "name": "max_angular_vel",
      "type": "float",
      "default": 1.2,
      "description": "最大角速度 (rad/s)",
      "min_value": 0.1,
      "max_value": 3.5
    },
    {
      "name": "avoidance_radius",
      "type": "float",
      "default": 0.6,
      "description": "障礙物減速半徑 (m)",
      "min_value": 0.1,
      "max_value": 3.0
    }
  ]
}
